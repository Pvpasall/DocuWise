# DocuWise – variables d'environnement
# Copie ce fichier en .env.local puis renseigne ta clé.
#
# Clé API Groq (gratuite) : https://console.groq.com/keys
GROQ_API_KEY=

# Modèle Groq (vision) utilisé pour l'OCR + l'explication.
# Par défaut : Llama 4 Scout (gratuit, supporte les images).
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
