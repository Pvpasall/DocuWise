# DocuWise – variables d'environnement
# Copie ce fichier en .env.local puis renseigne ta clé.
#
# Clé API Groq (gratuite) : https://console.groq.com/keys
GROQ_API_KEY=

# Modèle Groq (TEXTE — l'OCR est fait localement, pas besoin de modèle vision).
# Exemples gratuits : llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen/qwen3-32b
# Liste complète : https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Limite de tokens de sortie. Baisse cette valeur si tu vois une erreur 429
# (limite tokens/minute du tier gratuit).
GROQ_MAX_TOKENS=1024
